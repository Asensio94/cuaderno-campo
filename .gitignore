node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
# Claves y cuotas: Pl@ntNet y lo que venga detras van en el entorno, nunca aqui.
.env
.env.*

# Entornos de Python de los trabajadores (birdnet-analyzer arrastra TensorFlow: no se versiona).
.venv/
trabajadores/*/.venv/

# Estado del trabajador de BirdNET: su almacén, sus medios y su JSONL de vuelta. Son datos, no
# fuente; el registro de verdad vive en el teléfono.
trabajadores/*/estado/

# Los mosaicos se extraen del planeta de Protomaps, no se versionan (datos/mosaicos/extraer.py).
datos/mosaicos/*.pmtiles
datos/mosaicos/*.parcial
