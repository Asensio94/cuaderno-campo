node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
# Claves y cuotas: Pl@ntNet y lo que venga detras van en el entorno, nunca aqui.
.env
.env.*

# Entornos de Python de los trabajadores (birdnet-analyzer arrastra TensorFlow: no se versiona).
.venv/
trabajadores/*/.venv/

# Estado del trabajador de BirdNET: su almacén, sus medios y su JSONL de vuelta. Son datos, no
# fuente; el registro de verdad vive en el teléfono.
trabajadores/*/estado/

# Los mosaicos se extraen del planeta de Protomaps, no se versionan (datos/mosaicos/extraer.py).
datos/mosaicos/*.pmtiles
datos/mosaicos/*.parcial

# Los pesos de BirdNET empaquetados para el teléfono (datos/birdnet/empaquetar.py): 82 MB bajo
# CC BY-NC-SA que se generan en casa y se meten en el aparato como un mapa.
datos/birdnet/*/*.modelo
datos/birdnet/*/*.modelo.parcial

# Las fichas de especie (datos/fichas/generar.py): texto de Wikipedia y GBIF que se genera en
# casa y se mete en el aparato como un mapa. La caché de respuestas de las APIs, con ellas.
datos/fichas/*.fichas
datos/fichas/*.fichas.parcial
datos/fichas/cache/
