    "src/imagen/trabajador.ts",
    "src/wa-sqlite.d.ts",
    "../nucleo/registro-ts"
  ],
  "exclude": [
    "../nucleo/registro-ts/sqlite-node.ts",
    "../nucleo/registro-ts/**/*.test.ts",
    "../nucleo/registro-ts/**/*.pruebas.ts"
  ]
